//@version=6
indicator("真庄家 vs 游资 DWM 强度 (对齐 v7pro_mcdx_scan.py)", overlay=false, max_labels_count=500)

// =====================================================
// 输入参数 (与 v7pro_mcdx_scan.py 常数完全对齐)
// =====================================================
bankerPeriod = input.int(50, "庄家 RSI 周期", group = "MCDX 参数")
bankerBase   = input.float(50.0, "庄家基准", group = "MCDX 参数")
bankerSens   = input.float(1.4, "庄家灵敏度", group = "MCDX 参数")
hotPeriod    = input.int(40, "游资 RSI 周期", group = "MCDX 参数")
hotBase      = input.float(30.0, "游资基准", group = "MCDX 参数")
hotSens      = input.float(0.65, "游资灵敏度", group = "MCDX 参数")
strongTh     = input.float(14.0, "强势门槛 (0-20)", group = "MCDX 参数")
mediumTh     = input.float(7.0, "中等门槛 (0-20)", group = "MCDX 参数")

dayWeight    = input.float(20.0, "日线权重 %", group = "真庄家强度 (DWM加权)")
weekWeight   = input.float(35.0, "周线权重 %", group = "真庄家强度 (DWM加权)")
monthWeight  = input.float(45.0, "月线权重 %", group = "真庄家强度 (DWM加权)")

// =====================================================
// 核心 MCDX 计算 (banker / hot / retail / dominant)
// dominant: 0=庄家  1=游资  2=散户  -1=无主导
// =====================================================
f_banker(src) =>
    rsiBanker = ta.rsi(src, bankerPeriod)
    math.min(math.max(bankerSens * (rsiBanker - bankerBase), 0.0), 20.0)

f_hot(src) =>
    rsiHot = ta.rsi(src, hotPeriod)
    math.min(math.max(hotSens * (rsiHot - hotBase), 0.0), 20.0)

f_dominant(src) =>
    banker = f_banker(src)
    hot    = f_hot(src)
    retail = math.min(math.max(20.0 - math.max(banker, hot), 0.0), 20.0)
    dom = -1.0
    if banker >= mediumTh and banker >= hot and banker >= retail
        dom := 0.0
    else if hot >= mediumTh and hot >= banker and hot >= retail
        dom := 1.0
    else if retail >= mediumTh and retail >= banker and retail >= hot
        dom := 2.0
    dom

// =====================================================
// 日 / 周 / 月 三层取值 (固定拉 D/W/M，不受当前图表周期影响，
// 跟 python 版 resample_ohlcv 到 'D'/'W'/'ME' 的行为一致)
// =====================================================
bD = request.security(syminfo.tickerid, "D", f_banker(close), lookahead = barmerge.lookahead_off)
bW = request.security(syminfo.tickerid, "W", f_banker(close), lookahead = barmerge.lookahead_off)
bM = request.security(syminfo.tickerid, "M", f_banker(close), lookahead = barmerge.lookahead_off)

domD = request.security(syminfo.tickerid, "D", f_dominant(close), lookahead = barmerge.lookahead_off)
domW = request.security(syminfo.tickerid, "W", f_dominant(close), lookahead = barmerge.lookahead_off)
domM = request.security(syminfo.tickerid, "M", f_dominant(close), lookahead = barmerge.lookahead_off)

// =====================================================
// 真庄家强度：只用 banker 原始值做 DWM 加权，不混入游资分数
// (对齐 python 的 dwm_weighted_banker())
// =====================================================
totalW = dayWeight + weekWeight + monthWeight
bankerStrength = (bD * dayWeight + bW * weekWeight + bM * monthWeight) / totalW

isRealBankerDWM = domD == 0 and domW == 0 and domM == 0   // 真庄家日周月全控盘
isHotMoneyOnlyDWM = domD == 1 and domW == 1 and domM == 1 // 纯游资推动，无真庄家参与

f_domLabel(d) =>
    d == 0 ? "庄家" : d == 1 ? "游资" : d == 2 ? "散户" : "N/A"

f_domColor(d) =>
    d == 0 ? color.lime : d == 1 ? color.orange : d == 2 ? color.red : color.gray

// =====================================================
// 绘图
// =====================================================
plot(bankerStrength, "真庄家强度 (0-20)", color = color.new(#f5a623, 0), linewidth = 2)
hline(strongTh, "强庄门槛", color = color.gray, linestyle = hline.style_dashed)
hline(mediumTh, "中等门槛", color = color.gray, linestyle = hline.style_dotted)
bgcolor(isRealBankerDWM ? color.new(color.green, 85) : isHotMoneyOnlyDWM ? color.new(color.orange, 90) : na)

plotshape(isRealBankerDWM and not isRealBankerDWM[1], title = "真庄家DWM满仓触发",
     style = shape.triangleup, location = location.bottom, color = color.lime, size = size.tiny)

// =====================================================
// 状态表 (右下角)：D/W/M 各自主导类型 + banker 原始值 + 加权真庄家强度
// =====================================================
var table t = table.new(position.bottom_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "周期", bgcolor = color.gray, text_color = color.white)
    table.cell(t, 1, 0, "主导 / banker值", bgcolor = color.gray, text_color = color.white)
    table.cell(t, 0, 1, "日 D", text_color = color.white)
    table.cell(t, 1, 1, f_domLabel(domD) + "  " + str.tostring(bD, "#.#"), text_color = f_domColor(domD))
    table.cell(t, 0, 2, "周 W", text_color = color.white)
    table.cell(t, 1, 2, f_domLabel(domW) + "  " + str.tostring(bW, "#.#"), text_color = f_domColor(domW))
    table.cell(t, 0, 3, "月 M", text_color = color.white)
    table.cell(t, 1, 3, f_domLabel(domM) + "  " + str.tostring(bM, "#.#"), text_color = f_domColor(domM))
    table.cell(t, 0, 4, "真庄家强度", text_color = color.white)
    table.cell(t, 1, 4, str.tostring(bankerStrength, "#.#") + " / 20",
         text_color = bankerStrength >= strongTh ? color.lime : bankerStrength >= mediumTh ? color.yellow : color.red)

// =====================================================
// 供其他脚本 export 使用 (方便合并进主 V7pro 指标时直接引用)
// =====================================================
plot(bD, "banker_D", display = display.data_window)
plot(bW, "banker_W", display = display.data_window)
plot(bM, "banker_M", display = display.data_window)
plot(domD, "dominant_D", display = display.data_window)
plot(domW, "dominant_W", display = display.data_window)
plot(domM, "dominant_M", display = display.data_window)
